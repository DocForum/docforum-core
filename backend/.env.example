DATABASE_URL=postgresql://docforum:docforum@localhost:5432/docforum_dev
JWT_ACCESS_SECRET=changeme
JWT_REFRESH_SECRET=changeme
PORT=4000
# CORS allowlist (Phase 8, issue #37). Comma-separated; `CORS_ORIGIN` still
# works as a single-origin fallback. Defaults: local dev =
# http://localhost:5173 + http://127.0.0.1:5173, production =
# https://docforum.github.io.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email verification (Phase 8, issue #34). Defaults are in src/config/index.ts.
# No email provider exists yet (Phase 6, issue #17) — see scripts/README.md for
# the interim operator path on a hosted deployment.
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
EMAIL_VERIFICATION_RESEND_INTERVAL_SECONDS=60
EMAIL_VERIFICATION_LANDING_URL=http://localhost:5173/verify-email
# Express `trust proxy` (Phase 8, issue #35). Login throttling keys on the
# client IP, so this must match the real deployment: `1` behind Render's
# single proxy hop, `false` (the default) for local dev with nothing in
# front. `true` would let a client spoof X-Forwarded-For; leaving it unset in
# production makes every request look like the proxy's own address.
TRUST_PROXY=false

# Login throttling (Phase 8, issue #35). Defaults are in src/config/index.ts.
LOGIN_THROTTLE_WINDOW_SECONDS=900
LOGIN_THROTTLE_BACKOFF_AFTER=3
LOGIN_THROTTLE_BACKOFF_BASE_SECONDS=2
LOGIN_THROTTLE_BACKOFF_MAX_SECONDS=300
LOGIN_THROTTLE_LOCK_AFTER=10
LOGIN_THROTTLE_LOCK_SECONDS=900
LOGIN_THROTTLE_PRUNE_INTERVAL_SECONDS=3600
LOGIN_THROTTLE_PRUNE_AFTER_SECONDS=86400

# Active refresh sessions per user (Phase 8, issue #278). The least recently
# used sessions are revoked when a login would exceed this cap. Must be >= 1.
MAX_ACTIVE_SESSIONS_PER_USER=10

# PHI read-access log retention (Phase 8, issue #45). AccessLog rows older
# than this many days are deleted by the prune job in src/server.ts.
ACCESS_LOG_RETENTION_DAYS=365

# Auth-artifact retention (Phase 8, issue #276). Deletes expired/consumed
# verification and reset tokens, admin invites and SEP-10 challenges, plus
# sessions revoked more than the grace period ago. Deletes run in bounded
# batches of AUTH_TOKEN_PRUNE_BATCH_SIZE, up to
# AUTH_TOKEN_PRUNE_MAX_BATCHES_PER_RUN batches per table per tick.
AUTH_TOKEN_PRUNE_GRACE_HOURS=24
AUTH_TOKEN_PRUNE_BATCH_SIZE=500
AUTH_TOKEN_PRUNE_MAX_BATCHES_PER_RUN=20
AUTH_TOKEN_PRUNE_INTERVAL_SECONDS=3600

# Idempotent retries (Phase 8, issue #48). Defaults are in src/config/index.ts.
IDEMPOTENCY_RECORD_TTL_HOURS=24
IDEMPOTENCY_IN_PROGRESS_TIMEOUT_SECONDS=30
IDEMPOTENCY_MAX_CACHED_BODY_BYTES=1048576

# Patient data export (Phase 8, issue #40). Defaults are in src/config/index.ts.
PATIENT_EXPORT_TTL_HOURS=24
PATIENT_EXPORT_PAGE_SIZE=200
PATIENT_EXPORT_CHUNK_BYTES=262144
PATIENT_EXPORT_WORKER_INTERVAL_SECONDS=15
PATIENT_EXPORT_CLEANUP_INTERVAL_SECONDS=300
PATIENT_EXPORT_STALE_AFTER_SECONDS=900
PATIENT_EXPORT_MAX_ATTEMPTS=3

# Account deletion purge (Phase 8, issue #41, docs/adr/0010). Only record-free
# tombstones are purged; the grace period is operational, not legal.
ACCOUNT_PURGE_GRACE_HOURS=24
ACCOUNT_PURGE_INTERVAL_SECONDS=21600
REFERRAL_PENDING_TTL_DAYS=14
REFERRAL_EXPIRY_SWEEP_INTERVAL_SECONDS=3600
# Order-expiry sweep batching (issue #348). Both the unconfirmed-order and
# lab-order sweeps select at most BATCH_SIZE ids ordered by id per batch and
# process at most MAX_PER_RUN ids per tick. Leftovers are picked up by the
# next scheduled run. A cap below the batch size is raised to the batch size.
EXPIRY_SWEEP_BATCH_SIZE=100
EXPIRY_SWEEP_MAX_PER_RUN=1000
FEATURE_FLAG_CACHE_TTL_SECONDS=15

# Guardians and dependents (Phase 8, issue #42, docs/adr/0011). Guardian
# access ends when a dependent reaches this age (UTC calendar date).
AGE_OF_MAJORITY_YEARS=18

# Payments (Phase 5.5 — custodial v1, see docs/adr/0004-custodial-payments-v1.md)
# Testnet only (docforum-escrow hard rule 4) — real secret keys, never commit
# a filled-in .env. Generate + fund your own with:
#   node scripts/gen-platform-identities.mjs
# (writes secrets directly to .env, never prints them).
# Admin invites (Phase 8, issue #39). `ADMIN_INVITE_ACCEPT_URL` is where the
# invite link points — docforum-web owns that page.
ADMIN_INVITE_TTL_HOURS=72
ADMIN_INVITE_ACCEPT_URL=http://localhost:5173/accept-admin-invite

PLATFORM_PAYER_SECRET=
PLATFORM_RELEASER_SECRET=
# The live testnet docforum-escrow deployment this repo currently targets
# Leave empty for standard local dev; set when running against live testnet contract.
# When ESCROW_CONTRACT_ID is set, ESCROW_HEALTHCHECK_ID is required for startup verification.
ESCROW_CONTRACT_ID=
# Native XLM SAC on testnet (stellar contract id asset --asset native --network testnet)
# Kept as the legacy fallback for PaymentIntent rows created before #79;
# new intents take their token from PAYMENT_ASSETS below.
ESCROW_TOKEN_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Per-environment payment asset allowlist (issue #79). JSON array of
# { code, tokenContractId, decimals, issuer? }. Defaults (testnet XLM + USDC)
# live in src/config/index.ts; production MUST set this explicitly with
# mainnet contract ids. Only assets without clawback, transfer fees or
# rebasing belong here (escrow threat model T5).
# PAYMENT_ASSETS=[{"code":"XLM","tokenContractId":"CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC","decimals":7},{"code":"USDC","tokenContractId":"CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA","decimals":7,"issuer":"GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5"}]
# Horizon is read only for payee trustline checks before funding/prepare.
HORIZON_URL=https://horizon-testnet.stellar.org

# ADR 0005 prepare (issue #80). Defaults are in src/config/index.ts.
# prepared transaction TTL, and the expiry sweep cadence.
PAYMENT_PREPARE_TTL_SECONDS=300
PAYMENT_PREPARE_EXPIRY_SWEEP_INTERVAL_SECONDS=60
# refund_after = order expiry + grace; orders have no expiry field yet
# (Phase 4), so the intent's createdAt is the anchor.
PAYMENT_ORDER_EXPIRY_HOURS=72
PAYMENT_REFUND_GRACE_HOURS=24

# Contract event ingestion (issue #86). Use comma-separated id@deployment-ledger
# pairs to include current and historical redeployments. Each deployment needs
# its own start ledger so RPC retention loss is detected rather than skipped.
# Leave empty in local dev unless running live testnet event polling.
ESCROW_CONTRACTS=
# SOROBAN_RPC_URL may override ESCROW_RPC_URL for the event poller.
ESCROW_EVENT_POLL_INTERVAL_SECONDS=15
# Optional JSON webhook for high-severity unmatched release/refund events.
ESCROW_EVENT_ALERT_WEBHOOK_URL=
# Signing backend (issue #87). env keeps the current local-key behaviour; remote uses the HTTP signer contract in docs/adr/0004.
PLATFORM_SIGNER_MODE=env
PLATFORM_PAYER_PUBLIC_KEY=
PLATFORM_RELEASER_PUBLIC_KEY=
PLATFORM_SIGNER_URL=
PLATFORM_SIGNER_TOKEN=
PLATFORM_SIGNER_TIMEOUT_MS=10000
# Network and contract safeguards (issue #88). Startup probes this known escrow when configured.
ESCROW_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
ESCROW_RPC_URL=https://soroban-testnet.stellar.org
ESCROW_HEALTHCHECK_ID=
# Comma-separated read-only legacy registries and accepted escrow tokens.
ESCROW_LEGACY_CONTRACT_IDS=
ESCROW_ASSET_ALLOWLIST=
# Mainnet is refused unless explicitly enabled after security review.
ALLOW_MAINNET=false
# Issue #92 testnet-only prototype: defaults to direct facility payouts.
# `pooled` routes escrow payouts to this shared G-address and is rejected in
# production; use only a testnet account during evaluation.
PAYOUT_PRIVACY_MODE=facility
PAYOUT_PRIVACY_POOL_ADDRESS=

# Lab result file storage (Phase 5, issue #16 — docs/adr/0018). A PRIVATE S3
# bucket ("block all public access" on). With no bucket set the server still
# starts and the lab result endpoints answer 503. Credentials come from the
# AWS SDK default chain — AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here, or an
# instance role. OBJECT_STORAGE_ENDPOINT + FORCE_PATH_STYLE=true are only for
# S3-compatible stores (e.g. local MinIO). OBJECT_STORAGE_DRIVER=memory is
# for tests and refused in production.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
LAB_RESULT_MAX_BYTES=10485760
# Issue #72 (PRD §8.2.7): how long an abnormal/critical result may sit
# unacknowledged before it enters the admin escalation queue, and how often
# the escalation sweep runs.
LAB_RESULT_ESCALATION_HOURS=24
LAB_RESULT_ESCALATION_SWEEP_SECONDS=300

DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000

# TOTP two-factor authentication (Phase 8, issue #36). The secret is stored
# encrypted with FIELD_ENCRYPTION_KEY_* (issue #46), so those keys must be
# configured wherever 2FA is used. TOTP_REQUIRE_FOR_ADMIN=true makes enrolment
# mandatory for admin accounts: without it they get only a short-lived
# enrolment token at login. Roll it out only after admins have enrolled.
TOTP_ISSUER=DocForum
TOTP_REQUIRE_FOR_ADMIN=false
TOTP_MFA_TOKEN_TTL_MINUTES=5

# Facility payout-wallet cool-down (issue #328). A facility re-link becomes
# the escrow payee only after this many hours; funding keeps paying the
# previous address until then. The first-ever link is immediate. 0 disables
# it (local development only).
WALLET_LINK_COOLDOWN_HOURS=24

# Cross-instance real-time notification fan-out (issue #330). `pg` uses
# Postgres LISTEN/NOTIFY on a dedicated connection per instance; `local` keeps
# delivery in-process (single instance only). Reconnect backoff in ms.
NOTIFICATION_FANOUT_DRIVER=pg
NOTIFICATION_FANOUT_RECONNECT_MIN_MS=500
NOTIFICATION_FANOUT_RECONNECT_MAX_MS=30000

# ---------------------------------------------------------------------------
# Variables below were added for issue #344 so every setting the backend reads
# is discoverable. `npm run check:env` (run in CI) fails when src/ reads a
# variable that has no `NAME=` line here (commented-out lines count). Values
# are the code defaults; secrets are empty or clearly fake placeholders.
# ---------------------------------------------------------------------------

# Server / logging
# Public URL of docforum-web, used to build links in emails.
APP_BASE_URL=http://localhost:5173
# Legacy single-origin CORS fallback; CORS_ORIGINS above wins when set.
# CORS_ORIGIN=http://localhost:5173
# pino level; defaults to debug in dev, info in production, silent under tests.
# LOG_LEVEL=debug
# Serve /openapi.json and /docs. Defaults to true outside production.
# EXPOSE_OPENAPI=true

# Generic per-IP API rate limit (src/middleware/rate-limit.ts).
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# Field-level encryption (issue #46). Generate a key with
# `node scripts/gen-field-key.mjs`; FIELD_ENCRYPTION_KEY_<VERSION> holds the
# base64 32-byte key for each version, the active one encrypts new writes.
FIELD_ENCRYPTION_ACTIVE_VERSION=v1
FIELD_ENCRYPTION_KEY_V1=
# JWT key rotation overlap (docs/runbooks/secret-rotation.md). Optional.
# JWT_ACCESS_KID=access-current
# JWT_ACCESS_SECRET_PREVIOUS=
# JWT_ACCESS_KID_PREVIOUS=access-previous
# JWT_REFRESH_KID=refresh-current
# JWT_REFRESH_SECRET_PREVIOUS=
# JWT_REFRESH_KID_PREVIOUS=refresh-previous

# Password reset (Phase 8). Token lifetime and request limits.
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_REQUESTS_PER_EMAIL_PER_HOUR=3
PASSWORD_RESET_REQUESTS_PER_IP_PER_HOUR=10

# SEP-10 wallet authentication. Wallet login needs the three commented ones;
# SEP10_SIGNING_SECRET is a testnet secret key (never commit a real one).
# SEP10_HOME_DOMAIN=localhost
# SEP10_WEB_AUTH_DOMAIN=localhost:4000
# SEP10_SIGNING_SECRET=
SEP10_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
SEP10_HORIZON_URL=https://horizon-testnet.stellar.org
SEP10_CHALLENGE_TIMEOUT_SECONDS=300

# Availability / slots
SLOT_MIN_DURATION_MINUTES=5
SLOT_MAX_DURATION_MINUTES=240
SLOT_MAX_HORIZON_DAYS=365
SLOTS_DEFAULT_RANGE_DAYS=14
SLOTS_MAX_RANGE_DAYS=31

# Appointments: patients cannot cancel/reschedule within this many hours.
APPOINTMENT_CUTOFF_HOURS=2

# Consultations (issues #63, #64): attachments, sign-off and follow-up sweeps.
CONSULTATION_ATTACHMENT_MAX_BYTES=10485760
CONSULTATION_ATTACHMENT_MAX_PER_MESSAGE=5
CONSULTATION_ATTACHMENT_QUOTA_BYTES=52428800
CONSULTATION_ATTACHMENT_URL_TTL_SECONDS=300
# HMAC key for signed attachment URLs. Required in production; dev falls back
# to a per-process random key.
CONSULTATION_ATTACHMENT_URL_SECRET=
CONSULTATION_AUTO_SIGN_OFF_HOURS=24
CONSULTATION_SIGN_OFF_SWEEP_INTERVAL_SECONDS=3600
CONSULTATION_FOLLOW_UP_WINDOW_DAYS=14
CONSULTATION_FOLLOW_UP_SWEEP_INTERVAL_SECONDS=3600
CONSULTATION_THREAD_CLOSE_AFTER_DAYS=7

# Referrals: maximum chain length before a re-referral is refused.
REFERRAL_MAX_HOPS=4

# Orders (issue #76): unconfirmed-order expiry window and sweep cadence.
ORDER_CONFIRMATION_WINDOW_HOURS=72
ORDER_EXPIRY_INTERVAL_SECONDS=300
# HMAC key for order QR tokens; falls back to JWT_SECRET, then a dev-only value.
ORDER_TOKEN_SECRET=changeme-order-token-secret
# Legacy fallback for ORDER_TOKEN_SECRET. Prefer ORDER_TOKEN_SECRET.
# JWT_SECRET=

# Payments (extra)
# Ledger the event poller starts from when only ESCROW_CONTRACT_ID is set.
ESCROW_EVENT_START_LEDGER=1
# Overrides ESCROW_RPC_URL for the event poller.
# SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Funding attempts older than this are treated as stale.
ESCROW_FUNDING_STALE_AFTER_SECONDS=900
# Fee-sponsored transactions: sponsor account (falls back to
# PLATFORM_PAYER_PUBLIC_KEY) and per-patient / global budgets.
# PLATFORM_FEE_SPONSOR_PUBLIC_KEY=
FEE_SPONSOR_PER_PATIENT_LIMIT=10
FEE_SPONSOR_GLOBAL_LIMIT=1000
# ISO timestamp: payout wallets linked before it without verification may no
# longer receive funding after it (issue #328). Empty = 2027-01-01T00:00:00Z.
WALLET_LINK_UNVERIFIED_FUNDING_CUTOFF=

# Object storage driver: s3 (default when a bucket is set), memory (tests
# only, refused in production) or none.
# OBJECT_STORAGE_DRIVER=s3

# Upload malware scanning. With ClamAV disabled uploads are not scanned.
# FILE_SCANNING_FAIL_OPEN=false makes a scanner error block uploads with 503.
FILE_SCANNING_CLAMAV_ENABLED=false
FILE_SCANNING_CLAMAV_HOST=127.0.0.1
FILE_SCANNING_CLAMAV_PORT=3310
FILE_SCANNING_FAIL_OPEN=true

# Notifications: email (Postmark / SendGrid) and SMS (Twilio). Both channels
# are off by default; set the commented provider credentials to enable them.
EMAIL_ENABLED=false
EMAIL_FROM=DocForum <noreply@docforum.local>
# POSTMARK_SERVER_TOKEN=
# POSTMARK_WEBHOOK_SECRET=
SENDGRID_FROM_EMAIL=
SMS_ENABLED=false
SMS_DAILY_CAP=5
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# TWILIO_WEBHOOK_SECRET=

# TEST ONLY: `1` bypasses Postgres row-level security for queries without a
# request context. Never set it outside the test suite.
# RLS_TEST_BYPASS=1

# Lab-order TTLs in days (issue #313): expiresAt is set at issuance from
# these, and the lab-order expiry sweep expires (and refunds) unfulfilled
# orders past it.
LAB_ORDER_ROUTINE_TTL_DAYS=30
LAB_ORDER_URGENT_TTL_DAYS=7
