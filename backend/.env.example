DATABASE_URL=postgresql://docforum:docforum@localhost:5432/docforum_dev
JWT_ACCESS_SECRET=changeme
JWT_REFRESH_SECRET=changeme
PORT=4000
# CORS allowlist (Phase 8, issue #37). Comma-separated; `CORS_ORIGIN` still
# works as a single-origin fallback. Defaults: local dev =
# http://localhost:5173 + http://127.0.0.1:5173, production =
# https://docforum.github.io.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email verification (Phase 8, issue #34). Defaults are in src/config/index.ts.
# No email provider exists yet (Phase 6, issue #17) — see scripts/README.md for
# the interim operator path on a hosted deployment.
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
EMAIL_VERIFICATION_RESEND_INTERVAL_SECONDS=60
EMAIL_VERIFICATION_LANDING_URL=http://localhost:5173/verify-email
# Express `trust proxy` (Phase 8, issue #35). Login throttling keys on the
# client IP, so this must match the real deployment: `1` behind Render's
# single proxy hop, `false` (the default) for local dev with nothing in
# front. `true` would let a client spoof X-Forwarded-For; leaving it unset in
# production makes every request look like the proxy's own address.
TRUST_PROXY=false

# Login throttling (Phase 8, issue #35). Defaults are in src/config/index.ts.
LOGIN_THROTTLE_WINDOW_SECONDS=900
LOGIN_THROTTLE_BACKOFF_AFTER=3
LOGIN_THROTTLE_BACKOFF_BASE_SECONDS=2
LOGIN_THROTTLE_BACKOFF_MAX_SECONDS=300
LOGIN_THROTTLE_LOCK_AFTER=10
LOGIN_THROTTLE_LOCK_SECONDS=900
LOGIN_THROTTLE_PRUNE_INTERVAL_SECONDS=3600
LOGIN_THROTTLE_PRUNE_AFTER_SECONDS=86400

# Patient data export (Phase 8, issue #40). Defaults are in src/config/index.ts.
PATIENT_EXPORT_TTL_HOURS=24
PATIENT_EXPORT_PAGE_SIZE=200
PATIENT_EXPORT_CHUNK_BYTES=262144
PATIENT_EXPORT_WORKER_INTERVAL_SECONDS=15
PATIENT_EXPORT_CLEANUP_INTERVAL_SECONDS=300
PATIENT_EXPORT_STALE_AFTER_SECONDS=900
PATIENT_EXPORT_MAX_ATTEMPTS=3

# Payments (Phase 5.5 — custodial v1, see docs/adr/0004-custodial-payments-v1.md)
# Testnet only (docforum-escrow hard rule 4) — real secret keys, never commit
# a filled-in .env. Generate + fund your own with:
#   node scripts/gen-platform-identities.mjs
# (writes secrets directly to .env, never prints them).
PLATFORM_PAYER_SECRET=
PLATFORM_RELEASER_SECRET=
# The live testnet docforum-escrow deployment this repo currently targets
# — see that repo's docs/testnet-deployments.md for the current value.
ESCROW_CONTRACT_ID=CAXESEEAJILFFCN3PH2HHNMWAAHLEB64UTJHZ6IP7C5BBICT3S3VODSM
# Native XLM SAC on testnet (stellar contract id asset --asset native --network testnet)
# Kept as the legacy fallback for PaymentIntent rows created before #79;
# new intents take their token from PAYMENT_ASSETS below.
ESCROW_TOKEN_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Per-environment payment asset allowlist (issue #79). JSON array of
# { code, tokenContractId, decimals, issuer? }. Defaults (testnet XLM + USDC)
# live in src/config/index.ts; production MUST set this explicitly with
# mainnet contract ids. Only assets without clawback, transfer fees or
# rebasing belong here (escrow threat model T5).
# PAYMENT_ASSETS=[{"code":"XLM","tokenContractId":"CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC","decimals":7},{"code":"USDC","tokenContractId":"CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA","decimals":7,"issuer":"GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5"}]
# Horizon is read only for payee trustline checks before funding/prepare.
HORIZON_URL=https://horizon-testnet.stellar.org

# ADR 0005 prepare (issue #80). Defaults are in src/config/index.ts.
# prepared transaction TTL, and the expiry sweep cadence.
PAYMENT_PREPARE_TTL_SECONDS=300
PAYMENT_PREPARE_EXPIRY_SWEEP_INTERVAL_SECONDS=60
# refund_after = order expiry + grace; orders have no expiry field yet
# (Phase 4), so the intent's createdAt is the anchor.
PAYMENT_ORDER_EXPIRY_HOURS=72
PAYMENT_REFUND_GRACE_HOURS=24
