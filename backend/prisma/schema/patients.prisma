// Patient profiles, data exports and guardianship (backend/src/modules/patients).

model PatientProfile {
  id           String    @id @default(uuid())
  version     Int      @default(1)
  // Null for a dependent (Phase 8, issue #42, docs/adr/0011): a
  // guardian-owned profile with no login of its own. Still unique, so a
  // login owns at most one profile. A DB CHECK (see the
  // guardian_dependent_profiles migration) requires dateOfBirth whenever
  // userId is null — the age-of-majority rule depends on it.
  userId       String?   @unique
  fullName     String
  dateOfBirth  DateTime?
  // Phase 8 (issue #41, docs/adr/0010): set when the owner deleted their
  // account. fullName/dateOfBirth are anonymised at the same moment; the row
  // itself stays so appointments and payments keep their foreign key.
  // getMyPatientProfile refuses an anonymised profile.
  anonymizedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // RESTRICT, not CASCADE (issue #41): a patient's User row is never
  // hard-deleted while this profile exists — deletion is anonymisation
  // (ADR 0010), and an accidental user delete must fail loudly rather than
  // take the clinical identity anchor with it. Optional since issue #42: a
  // dependent profile has no login.
  user            User?              @relation(fields: [userId], references: [id], onDelete: Restrict)
  appointments    Appointment[]
  waitlistEntries WaitlistEntry[]
  paymentIntents  PaymentIntent[]
  prescriptions   Prescription[]
  labOrders       LabOrder[]
  dataExports     PatientExport[]
  // Phase 3: the referrals this patient is the subject of (the opposite
  // side of Referral.patientProfileId).
  referrals       Referral[]
  // ADR 0005 step 1 (issue #80): the patient's verified Stellar payer
  // address, when one has been linked. Optional because linking is a
  // separate flow that nothing creates rows for yet.
  walletLink      PatientWalletLink?
  intakes        IntakeForm[]
  // Phase 2, issue #63: follow-ups this patient must book.
  followUpRequests FollowUpRequest[] @relation("FollowUpRequestsAsPatient")

  // Phase 8 (issue #45): who viewed this patient's records.
  accessLogs AccessLog[]

  // Phase 8 (issue #42, docs/adr/0011): guardians of this (dependent) profile.
  guardians     Guardianship[]
  orders        Order[]
  orderDisputes OrderDispute[]
}

// Phase 8 (issue #40): right-of-access export jobs. One row per request;
// the generated bundle itself lives in PatientExportChunk (below), not in
// this row. Lifecycle: pending -> processing -> ready -> expired, or
// -> failed. A job only moves forward through conditional UPDATEs
// (`WHERE status = ...`), the same shape as the booking guarantee, so two
// workers can never both generate one export.
enum PatientExportStatus {
  pending
  processing
  ready
  failed
  expired
}

model PatientExport {
  id               String              @id @default(uuid())
  // The owner. Every read is scoped by this, never by the export id alone.
  patientProfileId String
  status           PatientExportStatus @default(pending)
  // Bundle format version actually written (set when generation starts).
  schemaVersion    Int?
  // Fencing token: incremented on every claim. Chunks are keyed by it, and
  // the final `ready` transition is conditional on it, so a worker whose
  // claim went stale can never publish a half-written or superseded bundle.
  attempt          Int                 @default(0)
  startedAt        DateTime?
  generatedAt      DateTime?
  // Set when the job becomes `ready`; downloads are refused at or after it
  // even if the cleanup job hasn't run yet.
  expiresAt        DateTime?
  sizeBytes        Int?
  // How many chunks the published attempt wrote. A download that finds
  // fewer (cleanup ran mid-stream) aborts instead of handing out a
  // silently truncated JSON document.
  chunkCount       Int?
  // Machine-readable failure only (e.g. SECTION_FAILED + section name) —
  // never an exception message, which could echo patient data.
  failureCode      String?
  failedSection    String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  patientProfile PatientProfile       @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  chunks         PatientExportChunk[]

  @@index([patientProfileId, createdAt])
  @@index([status, expiresAt])
}

// The export bundle, stored as ordered text chunks of one JSON document
// (issue #40). Written incrementally while sections are paged, read back
// one chunk at a time on download, so neither side ever holds a whole
// patient history in memory. Kept in Postgres rather than object storage
// because no object-storage provider is integrated yet (ARCHITECTURE.md §2
// and §6.3.4) — only patients/repositories reads or writes it, so moving to
// S3 later replaces that storage seam, not the export design.
model PatientExportChunk {
  exportId String
  attempt  Int
  seq      Int
  data     String

  export PatientExport @relation(fields: [exportId], references: [id], onDelete: Cascade)

  @@id([exportId, attempt, seq])
}

// Phase 8 (issue #42, docs/adr/0011): replaces the unenforced
// PatientProfile.guardianUserId string. A guardian (a patient User) owns a
// dependent PatientProfile they created; there is deliberately no way to
// link an existing profile. Active = revokedAt is null AND the dependent is
// under AGE_OF_MAJORITY_YEARS (checked at request time from the DOB — no
// job flips anything). Never deleted: ending a guardianship sets revokedAt,
// so who had access, and when, stays on record.
model Guardianship {
  id                 String    @id @default(uuid())
  guardianUserId     String
  dependentProfileId String
  createdAt          DateTime  @default(now())
  revokedAt          DateTime?

  guardian         User           @relation(fields: [guardianUserId], references: [id], onDelete: Restrict)
  dependentProfile PatientProfile @relation(fields: [dependentProfileId], references: [id], onDelete: Restrict)

  // One row per (guardian, dependent) pair — no duplicate or ambiguous
  // relationships. More than one guardian per dependent is allowed by the
  // model (two parents), though v1's API only creates one.
  @@unique([guardianUserId, dependentProfileId])
  @@index([dependentProfileId])
}
