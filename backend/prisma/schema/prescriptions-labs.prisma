// Append-only prescriptions and lab orders (backend/src/modules/prescriptions, lab-orders).

enum Urgency {
  routine
  urgent
}

// Issue #68: who did what to a referral, when, and why. Deliberately NOT a
// second audit table: the append-only `AuditEvent` in this schema (Phase 8,
// issue #43) is the one audit trail, so referral admin actions are recorded
// as `entityType: 'Referral'` rows through the audit module
// (`auditService.record`) — same table, same triggers, same writer.

model Prescription {
  id                       String      @id @default(uuid())
  consultationId           String
  patientProfileId         String
  prescribingDoctorId      String
  facilityProfileId        String
  amountStroops            BigInt
  status                   OrderStatus @default(issued)
  supersedesPrescriptionId String?
  createdAt                DateTime    @default(now())

  consultation      Consultation       @relation(fields: [consultationId], references: [id])
  patientProfile    PatientProfile     @relation(fields: [patientProfileId], references: [id])
  prescribingDoctor DoctorProfile      @relation(fields: [prescribingDoctorId], references: [id])
  facilityProfile   FacilityProfile    @relation(fields: [facilityProfileId], references: [id])
  supersedes        Prescription?      @relation("PrescriptionCorrections", fields: [supersedesPrescriptionId], references: [id])
  correctedBy       Prescription?      @relation("PrescriptionCorrections")
  items             PrescriptionItem[]
  paymentIntent     PaymentIntent?
  // One order → many fulfillment records (issue #73 split routing: one per
  // facility the patient routes items to).
  fulfillments      FulfillmentRecord[]

  @@unique([supersedesPrescriptionId])
  @@index([patientProfileId, createdAt])
  @@index([consultationId])
}

model PrescriptionItem {
  id             String @id @default(uuid())
  prescriptionId String
  drugName       String
  dosage         String
  frequency      String
  duration       String

  prescription Prescription @relation(fields: [prescriptionId], references: [id])

  @@index([prescriptionId])
}

model LabOrder {
  id                   String      @id @default(uuid())
  consultationId       String
  patientProfileId     String
  orderingDoctorId     String
  facilityProfileId    String
  amountStroops        BigInt
  testType             String
  urgency              Urgency     @default(routine)
  notes                String?
  status               OrderStatus @default(issued)
  supersedesLabOrderId String?
  createdAt            DateTime    @default(now())
  expiresAt            DateTime?

  consultation    Consultation       @relation(fields: [consultationId], references: [id])
  patientProfile  PatientProfile     @relation(fields: [patientProfileId], references: [id])
  orderingDoctor  DoctorProfile      @relation(fields: [orderingDoctorId], references: [id])
  facilityProfile FacilityProfile    @relation(fields: [facilityProfileId], references: [id])
  supersedes      LabOrder?          @relation("LabOrderCorrections", fields: [supersedesLabOrderId], references: [id])
  correctedBy     LabOrder?          @relation("LabOrderCorrections")
  result          LabResult?
  paymentIntent   PaymentIntent?
  fulfillments    FulfillmentRecord[]

  @@unique([supersedesLabOrderId])
  @@index([patientProfileId, createdAt])
  @@index([consultationId])
  @@index([status, expiresAt])
}

// Issue #72 (PRD §8.2.7): how serious the facility judged a result to be.
// Only the facility that attached the result sets it, at attach time.
enum LabResultAbnormality {
  normal
  abnormal
  critical
}

model LabResult {
  id                   String   @id @default(uuid())
  labOrderId           String   @unique
  fulfillingFacilityId String
  // Never written: a result file is not addressed by URL (issue #16).
  resultFileUrl        String?
  // Issue #16 (docs/adr/0014): the file lives in a private object-storage
  // bucket under this opaque, server-generated key — not a URL, never sent
  // to a client. It is read back only through
  // GET /orders/lab-orders/:labOrderId/result, which re-checks access.
  resultObjectKey      String?  @unique
  resultContentType    String?
  resultByteSize       Int?
  summary              String?
  // Issue #72: abnormal/critical results require the ordering doctor's
  // acknowledgement. `normal` is the default so a facility that has not
  // judged the result is not silently treated as "abnormal".
  abnormality          LabResultAbnormality @default(normal)
  createdAt            DateTime @default(now())

  labOrder           LabOrder        @relation(fields: [labOrderId], references: [id])
  fulfillingFacility FacilityProfile @relation(fields: [fulfillingFacilityId], references: [id])
  acknowledgement    LabResultAcknowledgement?
}

/// Issue #72: the "did anyone look at this?" record for an abnormal or
/// critical result. Created in the same transaction as the result; the
/// ordering doctor acknowledges it ONCE (conditional UPDATE, append-only in
/// spirit) and the escalation job stamps `escalatedAt` if the deadline
/// passes first. The row is the admin queue as well: anything with
/// `acknowledgedAt IS NULL` is visibly outstanding.
///
/// `escalationDueAt` is stored rather than derived from `createdAt` so the
/// window is fixed at attach time (changing the config later must not move
/// an existing deadline). Missing a job tick cannot skip escalation: the
/// admin list treats `escalationDueAt <= now` as overdue even before the job
/// has written `escalatedAt`, and the job drains the backlog on startup.
model LabResultAcknowledgement {
  id               String                @id @default(uuid())
  labResultId      String                @unique
  orderingDoctorId String
  severity         LabResultAbnormality
  escalationDueAt  DateTime
  acknowledgedAt   DateTime?
  // Which doctor actually acknowledged. Almost always the ordering doctor;
  // kept separate from `orderingDoctorId` so a future hand-off is auditable.
  acknowledgedByDoctorId String?
  escalatedAt      DateTime?
  createdAt        DateTime              @default(now())

  labResult      LabResult     @relation(fields: [labResultId], references: [id], onDelete: Restrict)
  orderingDoctor DoctorProfile @relation("LabResultAcknowledgementOrderingDoctor", fields: [orderingDoctorId], references: [id], onDelete: Restrict)

  // The doctor's outstanding-results list and the admin escalation queue
  // both scan the unacknowledged rows by deadline.
  @@index([acknowledgedAt, escalationDueAt])
  @@index([orderingDoctorId, acknowledgedAt])
}
