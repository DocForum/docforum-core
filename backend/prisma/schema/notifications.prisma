// Notifications and the transactional outbox (backend/src/modules/notifications).

enum NotificationChannel {
  in_app
  email
  sms
}

enum OutboxEventStatus {
  pending
  processing
  processed
  dead
}

model Notification {
  id            String              @id @default(uuid())
  userId        String
  sourceEventId String?             @unique
  type          String
  payload       Json
  channel       NotificationChannel @default(in_app)
  readAt        DateTime?
  createdAt     DateTime            @default(now())

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, createdAt, id])
  @@index([userId, readAt, createdAt, id])
}

model OutboxEvent {
  id             String            @id @default(uuid())
  type           String
  payload        Json
  status         OutboxEventStatus @default(pending)
  createdAt      DateTime          @default(now())
  processedAt    DateTime?
  attempts       Int               @default(0)
  lastError      String?
  availableAt    DateTime          @default(now())
  lockedAt       DateTime?
  deadLetteredAt DateTime?

  @@index([status, availableAt, createdAt, id])
  @@index([status, lockedAt])
}

enum NotificationDeliveryStatus {
  queued
  sent
  delivered
  failed
  bounced
  complained
}

enum SmsConsentStatus {
  opted_in
  opted_out
}

model NotificationDelivery {
  id                String                     @id @default(uuid())
  notificationId    String
  channel           NotificationChannel
  destination       String
  providerMessageId String?
  status            NotificationDeliveryStatus @default(queued)
  error             String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([channel, status, createdAt])
  @@index([destination, channel])
}

model SmsConsent {
  id        String           @id @default(uuid())
  userId    String
  phone     String
  status    SmsConsentStatus
  updatedAt DateTime         @updatedAt
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phone])
  @@index([phone, status])
}
