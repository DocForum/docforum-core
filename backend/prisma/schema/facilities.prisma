// Facilities, capabilities, prices and the medication catalog
// (backend/src/modules/facilities, medications).

enum FacilityType {
  lab
  pharmacy
}

enum CapabilityType {
  lab_test
  medication_dispense
}

model FacilityProfile {
  id        String       @id @default(uuid())
  version     Int      @default(1)
  userId    String       @unique
  name      String
  type      FacilityType
  // Phase 5 (issue #74): physical location so patients can find the
  // nearest qualified facility (PRD FR-13). All three nullable on
  // purpose — a facility that hasn't filled them in still appears in
  // eligible-facility queries, just sorted last (see
  // facilities/repositories).
  address   String?
  latitude  Float?
  longitude Float?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  capabilities      FacilityCapability[]
  prescriptions     Prescription[]
  labOrders         LabOrder[]
  labResults        LabResult[]
  paymentIntents    PaymentIntent[]
  fulfillments      FulfillmentRecord[]
  // NOTE: no `walletLink` relation anymore — WalletLink is generalized to
  // a polymorphic owner (patient | facility) as of issue #78, so it
  // carries no FK relation to either profile (same shape as
  // FulfillmentRecord's polymorphic order ref, §6.1.3). Ownership is
  // validated in the payments service, not by the schema.
  prices            FacilityPrice[]
  orders            Order[]
  fulfillmentProofs FulfillmentProof[]

  // Composite b-tree index backing the "indexed bounding box" prefilter
  // of the distance query (issue #74). Chosen over PostGIS: no extension
  // dependency on every deployment (incl. the Render free-tier preview),
  // and a bounding box + haversine is exact for the ORDER BY once the box
  // is a superset of the radius. See ARCHITECTURE.md §5.4.
  @@index([latitude, longitude])
}

/// Controlled medication vocabulary (issue #69, PRD FR-10). Prescription
/// items point at a row here instead of relying on free text alone, so a
/// pharmacy reads one unambiguous drug/strength/form/route, and the catalog
/// can later be matched against `FacilityCapability` (issue #320).
///
/// An issued `PrescriptionItem` stores its own display snapshot, so editing
/// or re-importing a catalog row never rewrites an already-issued order.
/// Rows are therefore RESTRICT-referenced by prescription items: a medication
/// that has been prescribed can't be deleted out from under the history.
///
/// `genericName` is trigram-indexed (see the migration — Prisma can't express
/// a `gin_trgm_ops` index); search is measured in
/// `backend/tests/integration/medications.test.mts`.
model Medication {
  id           String   @id @default(uuid())
  /// Generic (non-proprietary) name, e.g. "Amoxicillin".
  genericName  String
  /// Free-text strength as dispensed, e.g. "500 mg".
  strength     String
  /// Dosage form, e.g. "capsule", "tablet", "oral solution".
  form         String
  /// Route of administration, e.g. "oral", "topical", "intravenous".
  route        String
  /// Optional external identifier: RxNorm CUIs are not openly licensed, so
  /// the importer records whatever open code its source dataset provides
  /// (for the bundled openFDA NDC import that is the NDC product code).
  externalCode String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  prescriptionItems PrescriptionItem[]

  // A drug's identity for prescriptions is generic name + strength + form +
  // route; that tuple is what the importer upserts on.
  @@unique([genericName, strength, form, route])
  // The trigram index behind `GET /medications?q=` (issue #69). Declared here
  // rather than only in raw migration SQL so `scripts/check-migration-drift.mjs`
  // does not see a phantom index; the `pg_trgm` extension it needs is created
  // in the `medication_catalog` migration (Prisma has no extension syntax).
  @@index([genericName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Medication_genericName_trgm_idx")
}

model FacilityCapability {
  waitlistEntries   WaitlistEntry[]
  id                String          @id @default(uuid())
  version     Int      @default(1)
  facilityProfileId String
  capabilityType    CapabilityType
  // e.g. a lab test category, or a medication class — free text on purpose,
  // no controlled vocabulary decided yet (out of Phase 1 scope).
  detail            String?

  facilityProfile FacilityProfile @relation(fields: [facilityProfileId], references: [id], onDelete: Cascade)

  @@unique([facilityProfileId, capabilityType, detail])
}

/// Versioned facility price list (issue #127). Rows are append-only: changing
/// a price inserts a new row with a later `effectiveFrom`, so history is kept
/// and an intent priced earlier keeps resolving against what was in force at
/// its selection time. Amounts are stroops (BigInt) like PaymentIntent.
///
/// `catalogItemCode` is deliberately an open vocabulary (a lab test or
/// medication code the facility publishes), matching FacilityCapability.detail
/// — no controlled vocabulary has been decided yet.
model FacilityPrice {
  id              String          @id @default(uuid())
  facilityId      String
  facility        FacilityProfile @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  catalogItemCode String
  // Stellar asset the price is denominated in. v1 quotes native XLM
  // ('native'); the column exists so a price list can add assets without a
  // schema change when multi-asset payments land.
  asset           String
  amount          BigInt
  effectiveFrom   DateTime
  createdAt       DateTime        @default(now())

  // Two versions of the same item/asset cannot share an effective instant.
  // The generated names exceed Postgres's 63-byte limit, so the database
  // truncated them; `map` records the names that actually exist.
  @@unique([facilityId, catalogItemCode, asset, effectiveFrom], map: "FacilityPrice_facilityId_catalogItemCode_asset_effectiveFrom_ke")
  @@index([facilityId, catalogItemCode, asset, effectiveFrom], map: "FacilityPrice_facilityId_catalogItemCode_asset_effectiveFrom_id")
  @@index([catalogItemCode, asset, effectiveFrom])
}
