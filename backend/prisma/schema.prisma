// schema.prisma — DocForum canonical data model
// SOURCE OF TRUTH: if this file and ARCHITECTURE.md §4 disagree, fix ARCHITECTURE.md
// to match this file (or vice versa) in the same PR — see AGENTS.md.
//
// STATUS: Phase 1 models (User/PatientProfile/DoctorProfile/FacilityProfile/
// Specialty/DoctorSpecialty/FacilityCapability/AvailabilitySlot/Appointment)
// are fleshed out and migrated. Everything below the Phase 1 marker is still
// the Phase 0 structural placeholder — see ROADMAP.md.

generator client {
  provider = "prisma-client-js"
}

// Phase 8, issue #47: Prisma 7 no longer accepts `url` in the datasource
// block — the connection is configured in prisma.config.ts (for the CLI:
// migrate/generate/diff) and passed to PrismaClient as a driver adapter at
// runtime (see src/db/prisma-client.ts).
datasource db {
  provider = "postgresql"
}

enum Role {
  patient
  doctor
  facility
  admin
}

enum VerificationStatus {
  pending
  verified
  rejected
}

enum FacilityType {
  lab
  pharmacy
}

enum CapabilityType {
  lab_test
  medication_dispense
}

enum SlotStatus {
  open
  held
  booked
}

enum AppointmentStatus {
  scheduled
  completed
  cancelled
  no_show
}

enum AppointmentOrigin {
  direct_booking
  referral
}

enum ConsultationOutcome {
  resolved
  referred
  follow_up_needed
}

enum ReferralStatus {
  pending
  accepted
  declined
  completed
  expired
  // Admin-initiated termination (issue #68) — distinct from `expired`
  // (the cascade gave up after repeated no-shows) and `declined` (the
  // patient said no) so audit/metrics can tell the three exits apart.
  cancelled
}

enum OrderStatus {
  issued
  fulfilled
  expired
  superseded
}

enum FulfillmentStatus {
  pending
  in_progress
  fulfilled
  rejected
}

enum Urgency {
  routine
  urgent
}

enum AbnormalityFlag {
  normal
  abnormal
  critical
}

enum AcknowledgementStatus {
  pending
  acknowledged
  escalated
}

// =========================================================================
// Phase 1 models — identity, DB, safe booking foundation. See ROADMAP.md.
// =========================================================================

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  phone                 String?
  passwordHash          String
  role                  Role
  // Phase 8 (issue #34): null = never verified. Self-serve signup leaves
  // this null; existing rows were backfilled to `createdAt` in the
  // add_email_verification migration. Distinct from
  // DoctorProfile.verificationStatus, which is the separate, manual
  // admin verification of a doctor's credentials — do not conflate.
  emailVerifiedAt       DateTime?
  // Phase 9, issue #133: server-generated text preference. Values are
  // normalized to a supported language tag at signup; unsupported tags
  // fall back to English.
  locale                String    @default("en")
  // Phase 8 (issue #39): null = active. Deactivating never deletes anything
  // — no clinical or payment record is keyed to this flag, and none of the
  // deactivation paths remove rows. Login, refresh and access tokens are all
  // refused while this is set.
  deactivatedAt         DateTime?
  // Phase 8 (issue #39): bumped when an account is deactivated/reactivated,
  // so access tokens minted before that moment stop working immediately
  // instead of living out their 15-minute TTL. There is still no general
  // refresh-token revocation list (issue #18) — this is the narrow "revoke
  // everything for one account" case that deactivation needs.
  sessionsInvalidatedAt DateTime?
  // Per-user refresh-token version. Embedded in every access/refresh token
  // as `tv` and compared against this column at refresh time. Bumping it
  // (password reset, Phase 8 #33) invalidates every outstanding refresh
  // token for the user, since none of them carry the new value — the
  // interim kill switch issue #33 asked for while #18 doesn't exist yet.
  tokenVersion             Int       @default(0)
  // Phase 8 (issue #41, docs/adr/0010): set once, irreversibly, when the
  // account is deleted. The row is anonymised in place (email tombstoned,
  // phone cleared, password unusable) rather than deleted, because clinical
  // and payment records still reference its patient profile. Refresh is
  // refused once set. Distinct from admin deactivation (#39), which is
  // reversible.
  deletedAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  patientProfile  PatientProfile?
  doctorProfile   DoctorProfile?
  facilityProfile FacilityProfile?
  refreshSessions RefreshSession[]

  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  adminInvitesSent        AdminInvite[]
  // Phase 8 (issue #45): PHI read-access log rows this user wrote (as viewer).
  // Opposite of AccessLog.accessedByUser.
  accessLogs              AccessLog[]

  @@index([role])
}

// Phase 8 (issue #34): hashed, single-use, expiring email-verification
// tokens. Only the SHA-256 hash is persisted — a database leak must not
// hand out working verification links. One row per issued token so a
// resend can be rate-limited against the most recent `createdAt`.
model EmailVerificationToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Password reset tokens (Phase 8 #33). Only the SHA-256 hash of the
// token is ever stored — the raw token exists exactly once, in the
// notification that carries the reset link, and is never logged or
// persisted. Single-use (`usedAt`) and expiring (`expiresAt`).
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 hex of the raw token. Unique so lookup-by-hash is a single
  // indexed read, and a duplicate hash (astronomically unlikely) is a
  // constraint violation rather than a silent overwrite.
  tokenHash String    @unique
  expiresAt DateTime
  // Non-null once used or superseded by a newer request — either way the
  // token is dead. Requesting a second reset marks the first one used.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AdminInvite {
  id              String    @id @default(uuid())
  email           String
  tokenHash       String    @unique
  expiresAt       DateTime
  consumedAt      DateTime?
  invitedByUserId String
  createdAt       DateTime  @default(now())

  invitedBy User @relation(fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([email])
}

// Phase 8 (issue #35): login-throttle state. Deliberately in Postgres and
// not in process memory — the backend runs as a single Render instance
// today but must not assume that forever, and a restart must not hand an
// attacker a fresh budget. One row per (scope, key) bucket, where scope is
// `email` (normalised address) or `ip` (client IP, after the proxy chain is
// resolved — see TRUST_PROXY in src/config/index.ts).
//
// Counters are only ever moved by a single conditional upsert (see
// auth/repositories `recordFailedLoginAttempt`), never read-then-write: two
// concurrent bad logins for the same account must both be counted.
model LoginAttempt {
  id           String    @id @default(uuid())
  scope        String // 'email' | 'ip'
  key          String // normalised email, or client IP
  failedCount  Int       @default(0)
  // Start of the current sliding window; a failure outside the window
  // restarts the count at 1 instead of accumulating forever.
  windowStart  DateTime  @default(now())
  lastFailedAt DateTime  @default(now())
  // Set once this bucket has hit the lock threshold; cleared by a
  // successful login, an admin clear, or the start of a new window.
  lockUntil    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([scope, key])
  @@index([lastFailedAt])
}

// One row per refresh-token *family*, i.e. per login. This is the
// revocation store session management needs (Phase 8 #38) and the shape
// issue #18's refresh-token revocation wanted: the refresh JWT carries
// `sid`, and a refresh is only honoured while the row exists with
// `revokedAt` still null.
//
// Collecting a coarse IP and user agent here is deliberate — it is what
// makes "sign out that other device" usable. Nothing clinical or
// identifying beyond what the request itself already carried.
model RefreshSession {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now())
  // Updated on refresh only — never on every access-token-authenticated
  // request, so this doesn't become a write hot-spot on the User row.
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?

  userAgent String?
  ip        String?

  @@index([userId])
  @@index([userId, revokedAt])
}

model PatientProfile {
  id             String    @id @default(uuid())
  userId         String    @unique
  fullName       String
  dateOfBirth    DateTime?
  // Nullable, no FK relation on purpose — the minor/dependent consent and
  // account-ownership model is an explicit open PRD question (§8.2.5), not
  // resolved here. Don't build on top of this field assuming it means
  // anything enforced yet.
  guardianUserId String?
  // Phase 8 (issue #41, docs/adr/0010): set when the owner deleted their
  // account. fullName/dateOfBirth/guardianUserId are anonymised at the same
  // moment; the row itself stays so appointments and payments keep their
  // foreign key. getMyPatientProfile refuses an anonymised profile.
  anonymizedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // RESTRICT, not CASCADE (issue #41): a patient's User row is never
  // hard-deleted while this profile exists — deletion is anonymisation
  // (ADR 0010), and an accidental user delete must fail loudly rather than
  // take the clinical identity anchor with it.
  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  appointments   Appointment[]
  paymentIntents PaymentIntent[]
  prescriptions  Prescription[]
  labOrders      LabOrder[]
  dataExports    PatientExport[]
  // Phase 3: the referrals this patient is the subject of (the opposite
  // side of Referral.patientProfileId).
  referrals      Referral[]

  // Phase 8 (issue #45): who viewed this patient's records.
  accessLogs AccessLog[]
}

// Phase 8 (issue #40): right-of-access export jobs. One row per request;
// the generated bundle itself lives in PatientExportChunk (below), not in
// this row. Lifecycle: pending -> processing -> ready -> expired, or
// -> failed. A job only moves forward through conditional UPDATEs
// (`WHERE status = ...`), the same shape as the booking guarantee, so two
// workers can never both generate one export.
enum PatientExportStatus {
  pending
  processing
  ready
  failed
  expired
}

model PatientExport {
  id               String              @id @default(uuid())
  // The owner. Every read is scoped by this, never by the export id alone.
  patientProfileId String
  status           PatientExportStatus @default(pending)
  // Bundle format version actually written (set when generation starts).
  schemaVersion    Int?
  // Fencing token: incremented on every claim. Chunks are keyed by it, and
  // the final `ready` transition is conditional on it, so a worker whose
  // claim went stale can never publish a half-written or superseded bundle.
  attempt          Int                 @default(0)
  startedAt        DateTime?
  generatedAt      DateTime?
  // Set when the job becomes `ready`; downloads are refused at or after it
  // even if the cleanup job hasn't run yet.
  expiresAt        DateTime?
  sizeBytes        Int?
  // How many chunks the published attempt wrote. A download that finds
  // fewer (cleanup ran mid-stream) aborts instead of handing out a
  // silently truncated JSON document.
  chunkCount       Int?
  // Machine-readable failure only (e.g. SECTION_FAILED + section name) —
  // never an exception message, which could echo patient data.
  failureCode      String?
  failedSection    String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  patientProfile PatientProfile       @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  chunks         PatientExportChunk[]

  @@index([patientProfileId, createdAt])
  @@index([status, expiresAt])
}

// The export bundle, stored as ordered text chunks of one JSON document
// (issue #40). Written incrementally while sections are paged, read back
// one chunk at a time on download, so neither side ever holds a whole
// patient history in memory. Kept in Postgres rather than object storage
// because no object-storage provider is integrated yet (ARCHITECTURE.md §2
// and §6.3.4) — only patients/repositories reads or writes it, so moving to
// S3 later replaces that storage seam, not the export design.
model PatientExportChunk {
  exportId String
  attempt  Int
  seq      Int
  data     String

  export PatientExport @relation(fields: [exportId], references: [id], onDelete: Cascade)

  @@id([exportId, attempt, seq])
}

model DoctorProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  fullName           String
  verificationStatus VerificationStatus @default(pending)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialties        DoctorSpecialty[]
  availabilitySlots  AvailabilitySlot[]
  appointments       Appointment[]
  prescriptions      Prescription[]
  labOrders          LabOrder[]
  // Referral sides a doctor can sit on: `referringReferrals` are ones
  // they created; `targetedReferrals` are ones aimed at them (whether
  // they ultimately see the patient or not).
  referringReferrals Referral[]         @relation("ReferralReferringDoctor")
  targetedReferrals  Referral[]         @relation("ReferralTargetDoctor")
  // Lab result acknowledgements (issue #72)
  labResultAcknowledgements LabResultAcknowledgement[]

  @@index([verificationStatus])
}

model Specialty {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  doctors DoctorSpecialty[]
}

model DoctorSpecialty {
  id              String @id @default(uuid())
  doctorProfileId String
  specialtyId     String

  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  specialty     Specialty     @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@unique([doctorProfileId, specialtyId])
}

model FacilityProfile {
  id        String       @id @default(uuid())
  userId    String       @unique
  name      String
  type      FacilityType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  capabilities   FacilityCapability[]
  prescriptions  Prescription[]
  labOrders      LabOrder[]
  labResults     LabResult[]
  paymentIntents PaymentIntent[]
  walletLink     WalletLink?
  prices         FacilityPrice[]
}

model FacilityCapability {
  id                String         @id @default(uuid())
  facilityProfileId String
  capabilityType    CapabilityType
  // e.g. a lab test category, or a medication class — free text on purpose,
  // no controlled vocabulary decided yet (out of Phase 1 scope).
  detail            String?
  // Controlled vocabulary references (issues #69, #70)
  medicationId      String?
  labTestId         String?
  createdAt         DateTime       @default(now())

  facilityProfile FacilityProfile @relation(fields: [facilityProfileId], references: [id], onDelete: Cascade)
  medication      Medication?      @relation(fields: [medicationId], references: [id])
  labTest         LabTest?         @relation(fields: [labTestId], references: [id])

  @@unique([facilityProfileId, capabilityType, detail])
  @@unique([facilityProfileId, capabilityType, medicationId])
  @@unique([facilityProfileId, capabilityType, labTestId])
  @@index([medicationId])
  @@index([labTestId])
}

/// Versioned facility price list (issue #127). Rows are append-only: changing
/// a price inserts a new row with a later `effectiveFrom`, so history is kept
/// and an intent priced earlier keeps resolving against what was in force at
/// its selection time. Amounts are stroops (BigInt) like PaymentIntent.
///
/// `catalogItemCode` is deliberately an open vocabulary (a lab test or
/// medication code the facility publishes), matching FacilityCapability.detail
/// — no controlled vocabulary has been decided yet.
model FacilityPrice {
  id              String   @id @default(uuid())
  facilityId      String
  facility        FacilityProfile @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  catalogItemCode String
  // Stellar asset the price is denominated in. v1 quotes native XLM
  // ('native'); the column exists so a price list can add assets without a
  // schema change when multi-asset payments land.
  asset           String
  amount          BigInt
  effectiveFrom   DateTime
  createdAt       DateTime @default(now())

  // Two versions of the same item/asset cannot share an effective instant.
  @@unique([facilityId, catalogItemCode, asset, effectiveFrom])
  @@index([facilityId, catalogItemCode, asset, effectiveFrom])
  @@index([catalogItemCode, asset, effectiveFrom])
}

model AvailabilitySlot {
  id              String     @id @default(uuid())
  doctorProfileId String
  status          SlotStatus @default(open)
  startTime       DateTime
  endTime         DateTime
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  appointment   Appointment?

  // Prevents two slot ROWS for the same doctor/time range (duplicate
  // generation). This is NOT what prevents double-BOOKING of one slot by
  // two patients — that's the conditional `UPDATE ... WHERE status =
  // 'open'` in availability/services, inside a transaction. See
  // ARCHITECTURE.md §5.1 and the integration test in
  // backend/tests/integration/booking.test.ts.
  @@unique([doctorProfileId, startTime, endTime])
  @@index([doctorProfileId, status])
}

model Appointment {
  id                 String            @id @default(uuid())
  patientProfileId   String
  doctorProfileId    String
  // Nullable because a CANCELLED appointment releases its slot back to
  // `open` (referral cascade / patient cancel) — the appointment keeps its
  // history row but must stop holding the unique claim on the slot, or
  // re-booking the freed slot would violate the unique constraint.
  // The booking guarantee itself is unchanged: claimOpenSlot's
  // conditional UPDATE on SlotStatus is what prevents double-booking.
  availabilitySlotId String?           @unique
  status             AppointmentStatus @default(scheduled)
  origin             AppointmentOrigin @default(direct_booking)
  // Set when this appointment was produced by accepting a Referral (issue
  // #7). The cascade rules (#67 / PRD §8.2.3) react to status transitions
  // on exactly these appointments. NOT unique: one referral can produce
  // several appointments over its life (re-booking after a cancellation).
  // Referral.resultingAppointmentId is the unique "current" pointer.
  referralId         String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  // Explicit RESTRICT (was the Prisma default — same SQL): an appointment is
  // a clinical record and must outlive any account deletion (ADR 0010).
  patientProfile   PatientProfile    @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  doctorProfile    DoctorProfile     @relation(fields: [doctorProfileId], references: [id])
  availabilitySlot AvailabilitySlot? @relation(fields: [availabilitySlotId], references: [id])
  referral         Referral?         @relation("ReferralOriginatedAppointments", fields: [referralId], references: [id])
  // Non-owning side of Referral.resultingAppointmentId (the FK lives on
  // Referral) — which referral currently points at this appointment as
  // the one it produced.
  referralResultOf Referral?         @relation("ReferralResultingAppointment")
  // Phase 2 (issue #4): the appointment's consultation. 1:1 — the uniqueness
  // is Consultation.appointmentId UNIQUE (docs/adr/0009), so this side is a
  // plain back-relation.
  consultation     Consultation?

  // TODO Phase 2: intakeId (FK -> IntakeForm). PRD FR-5 requires intake
  // before confirmation, not enforced yet — booking works without it in
  // Phase 1 so the concurrency-safety work isn't blocked on IntakeForm
  // existing. Flagged, not silently dropped.
}

// =========================================================================
model AccessLog {
  id               String   @id @default(uuid())
  // Who viewed. SetNull on user delete keeps the log row (timestamp +
  // entity remain) while removing the PII pointer.
  accessedBy       String?
  // Which patient's records were viewed (the record owner, not the viewer).
  patientProfileId String?
  // Entity that was read: 'IntakeForm' | 'Consultation' | 'Prescription' |
  // 'LabOrder' | 'LabResult' | 'Referral' | 'PaymentIntent' | 'PatientProfile'
  entityType       String
  entityId         String
  // The HTTP route that returned the payload (for correlating with access logs).
  route            String?
  // Free-text detail — no PHI here, just context like "GET /appointments/mine".
  detail           String?
  accessedAt       DateTime @default(now())

  accessedByUser User?           @relation(fields: [accessedBy], references: [id], onDelete: SetNull)
  patientProfile PatientProfile? @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  @@index([accessedAt])
  @@index([accessedBy])
  @@index([patientProfileId, accessedAt])
  @@index([entityType, entityId])
}

// Below this line: Phase 0 structural placeholders, not yet implemented.
// See ROADMAP.md for phase order.
// =========================================================================

model IntakeForm {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  // TODO: patientProfileId, symptoms (Json), freeTextNotes
}

// Phase 3 (issue #5 minimal + lineage for #65): a Consultation is the
// record of a doctor having seen the patient at a specific appointment.
// `appointmentId` is the lineage seam — Referral.parentReferralId is
// derived through it (consultation → appointment → referral), which is
// what loop detection walks. Full consultation-note workflow (append-only
// addenda, sign-off) stays issue #4/#64's scope.
model Consultation {
  id            String               @id @default(uuid())
  // unique = "a consultation is closed once per appointment", enforced by the
  // database rather than by a read-then-write check (docs/adr/0009).
  appointmentId String               @unique
  // Nullable so a consultation can exist before sign-off (Phase 3's referral
  // slice); the close routes require it, so a closed record always has one.
  outcome       ConsultationOutcome?
  // Clinical free text: stored as an AES-256-GCM envelope by
  // consultations/services (issue #46 — ARCHITECTURE.md §4.3), never plaintext.
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  // RESTRICT (Prisma's default for a required relation) is what the existing
  // migration created: a clinical record must not disappear because an
  // appointment row was deleted.
  appointment   Appointment    @relation(fields: [appointmentId], references: [id])
  prescriptions Prescription[]
  labOrders     LabOrder[]
  // Phase 3: the referrals that grew out of this consultation (the
  // opposite side of Referral.sourceConsultationId).
  referrals     Referral[]
}

// Phase 3 (issues #5/#65/#66/#67/#68). Snapshot rule (FR-7/FR-8, hard
// rule 3): `snapshotNotes` is a copy taken at creation, never a live
// reference — reassign/cancel/cascade never touch it.
model Referral {
  id                        String         @id @default(uuid())
  status                    ReferralStatus @default(pending)
  patientProfileId          String
  // The consultation this referral grew out of. Required: every referral
  // is created from a consultation (PRD FR-7), which is also what gives
  // loop detection its lineage.
  sourceConsultationId      String
  referringDoctorId         String
  // Always a concrete doctor: a "specialty, no specific doctor" referral
  // is routed to one at creation (least-loaded eligible doctor — issue
  // #6, docs/adr/0008). The column stays NOT NULL on purpose, so an
  // unassigned referral cannot exist; when nobody is eligible the
  // creation fails instead of writing a row.
  targetDoctorId            String
  // Optional denormalised label of the target specialty, used by the
  // loop guard and admin views. Not a substitute for issue #23's real
  // per-doctor specialty management.
  targetSpecialtyId         String?
  snapshotNotes             String
  // Issue #65: the referral whose appointment produced the consultation
  // this referral came from — the chain loop detection walks (bounded).
  parentReferralId          String?
  // Issue #67 bookkeeping: how many times a referral-origin appointment
  // has no-showed, and the "the referring doctor must know" flag set
  // when repeated no-shows expire the referral. Both live on the
  // referral (not a Notification row) because Phase 6's dispatch layer
  // doesn't exist yet — the flag is the seam it will read.
  noShowCount               Int            @default(0)
  referringDoctorNotifiedAt DateTime?
  // Issue #65: set (with a reason naming the matching hop) when the
  // target doctor/specialty was already in the ancestor chain — the
  // referral is still created (a human decides), but surfaces in the
  // admin queue.
  loopFlaggedAt             DateTime?
  loopFlagReason            String?
  // Issue #68: admin-initiated cancellation carries its reason; the
  // audit trail proper is the AuditEvent row written alongside.
  cancelledReason           String?
  // The appointment this referral currently produced (null while
  // pending/declined, or after a cancelled/no-showed appointment returns
  // it to pending). Kept pointing at the last no-show when expired —
  // that appointment is why it expired.
  resultingAppointmentId    String?        @unique
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  sourceConsultation   Consultation   @relation(fields: [sourceConsultationId], references: [id])
  patientProfile       PatientProfile @relation(fields: [patientProfileId], references: [id])
  referringDoctor      DoctorProfile  @relation("ReferralReferringDoctor", fields: [referringDoctorId], references: [id])
  targetDoctor         DoctorProfile  @relation("ReferralTargetDoctor", fields: [targetDoctorId], references: [id])
  parentReferral       Referral?      @relation("ReferralLineage", fields: [parentReferralId], references: [id])
  childReferrals       Referral[]     @relation("ReferralLineage")
  resultingAppointment Appointment?   @relation("ReferralResultingAppointment", fields: [resultingAppointmentId], references: [id])
  // Every appointment this referral ever produced (including cancelled/
  // no-showed ones) — history survives the resultingAppointmentId link
  // being cleared when the referral returns to pending.
  appointments         Appointment[]  @relation("ReferralOriginatedAppointments")

  @@index([patientProfileId])
  @@index([referringDoctorId])
  @@index([targetDoctorId])
  @@index([status])
  @@index([loopFlaggedAt])
}

// Issue #68: who did what to a referral, when, and why. Deliberately NOT a
// second audit table: the append-only `AuditEvent` in this schema (Phase 8,
// issue #43) is the one audit trail, so referral admin actions are recorded
// as `entityType: 'Referral'` rows through the audit module
// (`auditService.record`) — same table, same triggers, same writer.

model Prescription {
  id                       String      @id @default(uuid())
  consultationId           String
  patientProfileId         String
  prescribingDoctorId      String
  facilityProfileId        String
  amountStroops            BigInt
  status                   OrderStatus @default(issued)
  supersedesPrescriptionId String?
  createdAt                DateTime    @default(now())

  consultation      Consultation       @relation(fields: [consultationId], references: [id])
  patientProfile    PatientProfile     @relation(fields: [patientProfileId], references: [id])
  prescribingDoctor DoctorProfile      @relation(fields: [prescribingDoctorId], references: [id])
  facilityProfile   FacilityProfile    @relation(fields: [facilityProfileId], references: [id])
  supersedes        Prescription?      @relation("PrescriptionCorrections", fields: [supersedesPrescriptionId], references: [id])
  correctedBy       Prescription?      @relation("PrescriptionCorrections")
  items             PrescriptionItem[]
  paymentIntent     PaymentIntent?

  @@unique([supersedesPrescriptionId])
  @@index([patientProfileId, createdAt])
  @@index([consultationId])
}

model PrescriptionItem {
  id             String   @id @default(uuid())
  prescriptionId String
  drugName       String
  dosage         String
  frequency      String
  duration       String
  // Controlled vocabulary reference (issue #69)
  medicationId   String?
  // Snapshot of medication details at issuance time (append-only rule)
  medicationName String?
  medicationStrength String?
  medicationForm String?
  medicationRoute String?
  createdAt      DateTime @default(now())

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medication   Medication?  @relation(fields: [medicationId], references: [id])

  @@index([prescriptionId])
  @@index([medicationId])
}

model Medication {
  id              String   @id @default(uuid())
  genericName     String
  strength        String?  // e.g., "500mg", "10mg/mL"
  form            String?  // e.g., "tablet", "capsule", "syrup", "injection"
  route           String?  // e.g., "oral", "intravenous", "topical"
  // External code (RxNorm, local formulary, etc.)
  externalCode    String?  @unique
  externalSystem  String?  // e.g., "rxnorm", "local"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  prescriptionItems PrescriptionItem[]
  facilityCapabilities FacilityCapability[]

  @@index([genericName])
  @@index([externalCode])
}

model LabOrder {
  id                   String      @id @default(uuid())
  consultationId       String
  patientProfileId     String
  orderingDoctorId     String
  facilityProfileId    String
  amountStroops        BigInt
  testType             String
  urgency              Urgency     @default(routine)
  notes                String?
  status               OrderStatus @default(issued)
  supersedesLabOrderId String?
  createdAt            DateTime    @default(now())

  consultation    Consultation    @relation(fields: [consultationId], references: [id])
  patientProfile  PatientProfile  @relation(fields: [patientProfileId], references: [id])
  orderingDoctor  DoctorProfile   @relation(fields: [orderingDoctorId], references: [id])
  facilityProfile FacilityProfile @relation(fields: [facilityProfileId], references: [id])
  supersedes      LabOrder?       @relation("LabOrderCorrections", fields: [supersedesLabOrderId], references: [id])
  correctedBy     LabOrder?       @relation("LabOrderCorrections")
  result          LabResult?
  paymentIntent   PaymentIntent?
  testCodes       LabOrderTestCode[]

  @@unique([supersedesLabOrderId])
  @@index([patientProfileId, createdAt])
  @@index([consultationId])
}

model LabOrderTestCode {
  id         String   @id @default(uuid())
  labOrderId String
  labTestId  String
  // Snapshot of the test code/name at issuance time (append-only rule)
  testCode   String
  testName   String
  createdAt  DateTime @default(now())

  labOrder LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  labTest  LabTest  @relation(fields: [labTestId], references: [id])

  @@unique([labOrderId, labTestId])
  @@index([labOrderId])
  @@index([labTestId])
}

model LabTest {
  id              String   @id @default(uuid())
  code            String   @unique // LOINC code or local formulary code
  name            String
  specimenType    String?  // e.g., "blood", "urine", "tissue"
  category        String?  // e.g., "hematology", "chemistry", "microbiology"
  panelOf         LabTest[] @relation("TestPanel")
  panelComponents LabTest[] @relation("TestPanel")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  labOrderTestCodes LabOrderTestCode[]
  facilityCapabilities FacilityCapability[]

  @@index([name])
  @@index([category])
}

model LabResult {
  id                   String            @id @default(uuid())
  labOrderId           String            @unique
  fulfillingFacilityId String
  resultFileUrl        String?
  summary              String?
  // Abnormality flag set by facility (issue #72)
  abnormalityFlag      AbnormalityFlag   @default(normal)
  createdAt            DateTime          @default(now())

  labOrder           LabOrder        @relation(fields: [labOrderId], references: [id])
  fulfillingFacility FacilityProfile @relation(fields: [fulfillingFacilityId], references: [id])
  acknowledgement    LabResultAcknowledgement?
}

model LabResultAcknowledgement {
  id          String               @id @default(uuid())
  labResultId String               @unique
  doctorId    String
  status      AcknowledgementStatus @default(pending)
  acknowledgedAt DateTime?
  escalatedAt   DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  labResult LabResult @relation(fields: [labResultId], references: [id], onDelete: Cascade)
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id])

  @@index([doctorId, status])
  @@index([status, createdAt])
}

model FulfillmentRecord {
  id        String            @id @default(uuid())
  orderType String // "prescription" | "lab_order" — see ARCHITECTURE.md §6.1.3 caveat on this polymorphic design
  orderId   String
  status    FulfillmentStatus @default(pending)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  // TODO: facilityId
  // NOTE: this polymorphic (orderType, orderId) pair is flagged in
  // ARCHITECTURE.md §6.1.3 as a design smell to revisit — may be split
  // into PrescriptionFulfillment / LabOrderFulfillment before implementation.
}

model OrderToken {
  id              String   @id @default(uuid())
  orderType       String   // "prescription" | "lab_order"
  orderId         String
  // HMAC-SHA256 or Ed25519 signature (opaque, no PHI encoded)
  token           String   @unique
  // Token version for revocation on supersede
  version         Int      @default(1)
  expiresAt       DateTime?
  createdAt       DateTime @default(now())

  @@index([orderType, orderId])
  @@index([token])
}

model Notification {
  id        String    @id @default(uuid())
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())
  // TODO: userId
}

// --- Stellar payments (docforum-org split) -------------------------------
// These two models hold relational metadata ONLY — amounts, status, tx
// hashes, public keys. No clinical/PHI field ever belongs here. The actual
// escrow contract logic lives in the sibling docforum-escrow repo and is
// called via the @docforum/escrow-sdk package from
// backend/src/modules/payments/services — never modeled or reimplemented
// in this schema. See docs/adr/0002-stellar-escrow-for-fulfillment-payout.md
// and docs/adr/0004-custodial-payments-v1.md.
//
// One of prescriptionId/labOrderId is required by a PostgreSQL check
// constraint. Amount and recipient are snapshotted from the issued order.

enum PaymentIntentStatus {
  created
  escrowed
  released
  refunded
  failed
}

model PaymentIntent {
  id             String              @id @default(uuid())
  prescriptionId String?             @unique
  labOrderId     String?             @unique
  status         PaymentIntentStatus @default(created)

  prescription Prescription? @relation(fields: [prescriptionId], references: [id])
  labOrder     LabOrder?     @relation(fields: [labOrderId], references: [id])

  patientProfileId String
  // Explicit RESTRICT (was the Prisma default — same SQL): a payment record
  // must outlive any account deletion (ADR 0010).
  patientProfile   PatientProfile  @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  facilityId       String
  facility         FacilityProfile @relation(fields: [facilityId], references: [id])

  // Raw stroops (native XLM's smallest unit) — matches
  // @docforum/escrow-sdk's `amount: bigint` exactly. v1 is native-XLM
  // only, no decimal/currency-conversion layer: an earlier scaffold draft
  // of this model used a Decimal amount + "USDC" currency default,
  // dropped here in favor of what's actually proven end-to-end on
  // testnet (see ADR 0004). Multi-asset support is a future addition,
  // not assumed by this field.
  amountStroops BigInt

  // Which facility price list entry priced this intent (issue #127). The
  // amount above is the snapshot; this code records *which* item it was for,
  // so a later price change can be explained without re-deriving it. Null for
  // intents priced from an admin-supplied amount.
  catalogItemCode String?

  // Set once funded (create_escrow succeeds) — needed to later call
  // release/refund against the right on-chain escrow.
  escrowId          BigInt?
  stellarTxHash     String?
  // Which deployed contract this intent was funded against — this repo
  // has already had two testnet contract IDs (Phase E1 vs. E2), so this
  // isn't hypothetical.
  sorobanContractId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([facilityId])
  @@index([status])
}

model WalletLink {
  id         String          @id @default(uuid())
  // Scoped to the facility being paid, not the patient — v1 is a
  // custodial model (docforum-core funds escrows from its own platform
  // Stellar identity; patients never hold or sign with a wallet here).
  // See ADR 0004.
  facilityId String          @unique
  facility   FacilityProfile @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  stellarPublicKey String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Soroban event ingestion (issue #86). Cursors are per contract deployment;
// persisted events are immutable observations used for reconciliation/alerts.
enum EscrowChainEventState {
  pending
  matched
  unmatched
}

model EscrowEventCursor {
  contractId   String   @id
  startLedger  Int
  cursor       String?
  lastLedger   Int?
  catchupError String?
  updatedAt    DateTime @updatedAt
}

model EscrowChainEvent {
  id              String                @id @default(uuid())
  eventId         String
  contractId      String
  ledger          Int
  txHash          String?
  escrowId        BigInt?
  eventType       String
  state           EscrowChainEventState @default(pending)
  paymentIntentId String?
  payload         Json?
  detectedAt      DateTime              @default(now())
  alertedAt       DateTime?

  @@unique([contractId, eventId])
  @@index([state, detectedAt])
  @@index([contractId, ledger])
}

// --- Audit trail (Phase 8, issue #43) -------------------------------------
// One row per state transition on a record that matters for clinical,
// legal or financial accountability (PRD §7: "who, when"). Written by the
// audit module's record(), always inside the same transaction as the
// change it describes — if the change rolls back, so does its event.
//
// APPEND-ONLY. There is no update or delete path in code, and a database
// trigger (see the add_audit_event migration) rejects UPDATE, DELETE and
// TRUNCATE outright. Deliberately no foreign keys: an FK's ON DELETE action
// would have to rewrite or remove audit rows (which the trigger forbids),
// and RESTRICT would let the audit trail block account lifecycle. Ids are
// recorded as facts about the past.
//
// No PHI, ever: `metadata` is a small flat map of ids/codes validated by
// record() — never names, contact details, DOB, intake text, or copies of
// request/response bodies.
model AuditEvent {
  id          String   @id @default(uuid())
  // Null only for system-initiated transitions (none exist yet).
  actorUserId String?
  actorRole   Role?
  // e.g. 'Appointment', 'DoctorProfile', 'PaymentIntent'.
  entityType  String
  entityId    String
  // e.g. 'appointment.booked', 'payment_intent.released'.
  action      String
  fromState   String?
  toState     String?
  // X-Request-Id of the HTTP request that caused it (src/middleware/request-id.ts).
  requestId   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([createdAt, id])
}
