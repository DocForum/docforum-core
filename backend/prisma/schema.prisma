// schema.prisma — DocForum canonical data model
// SOURCE OF TRUTH: if this file and ARCHITECTURE.md §4 disagree, fix ARCHITECTURE.md
// to match this file (or vice versa) in the same PR — see AGENTS.md.
//
// STATUS: Phase 1 models (User/PatientProfile/DoctorProfile/FacilityProfile/
// Specialty/DoctorSpecialty/FacilityCapability/AvailabilitySlot/Appointment)
// are fleshed out and migrated. Everything below the Phase 1 marker is still
// the Phase 0 structural placeholder — see ROADMAP.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  patient
  doctor
  facility
  admin
}

enum VerificationStatus {
  pending
  verified
  rejected
}

enum FacilityType {
  lab
  pharmacy
}

enum CapabilityType {
  lab_test
  medication_dispense
}

enum SlotStatus {
  open
  held
  booked
}

enum AppointmentStatus {
  scheduled
  completed
  cancelled
  no_show
}

enum AppointmentOrigin {
  direct_booking
  referral
}

enum ConsultationOutcome {
  resolved
  referred
  follow_up_needed
}

enum ReferralStatus {
  pending
  accepted
  declined
  completed
  expired
  // Admin-initiated termination (issue #68) — distinct from `expired`
  // (the cascade gave up after repeated no-shows) and `declined` (the
  // patient said no) so audit/metrics can tell the three exits apart.
  cancelled
}

enum OrderStatus {
  issued
  fulfilled
  expired
  superseded
}

enum FulfillmentStatus {
  pending
  in_progress
  fulfilled
  rejected
}

enum Urgency {
  routine
  urgent
}

// =========================================================================
// Phase 1 models — identity, DB, safe booking foundation. See ROADMAP.md.
// =========================================================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role
  // Phase 8 (issue #34): null = never verified. Self-serve signup leaves
  // this null; existing rows were backfilled to `createdAt` in the
  // add_email_verification migration. Distinct from
  // DoctorProfile.verificationStatus, which is the separate, manual
  // admin verification of a doctor's credentials — do not conflate.
  emailVerifiedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patientProfile  PatientProfile?
  doctorProfile   DoctorProfile?
  facilityProfile FacilityProfile?

  emailVerificationTokens EmailVerificationToken[]

  @@index([role])
}

// Phase 8 (issue #34): hashed, single-use, expiring email-verification
// tokens. Only the SHA-256 hash is persisted — a database leak must not
// hand out working verification links. One row per issued token so a
// resend can be rate-limited against the most recent `createdAt`.
model EmailVerificationToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Phase 8 (issue #35): login-throttle state. Deliberately in Postgres and
// not in process memory — the backend runs as a single Render instance
// today but must not assume that forever, and a restart must not hand an
// attacker a fresh budget. One row per (scope, key) bucket, where scope is
// `email` (normalised address) or `ip` (client IP, after the proxy chain is
// resolved — see TRUST_PROXY in src/config/index.ts).
//
// Counters are only ever moved by a single conditional upsert (see
// auth/repositories `recordFailedLoginAttempt`), never read-then-write: two
// concurrent bad logins for the same account must both be counted.
model LoginAttempt {
  id           String    @id @default(uuid())
  scope        String // 'email' | 'ip'
  key          String // normalised email, or client IP
  failedCount  Int       @default(0)
  // Start of the current sliding window; a failure outside the window
  // restarts the count at 1 instead of accumulating forever.
  windowStart  DateTime  @default(now())
  lastFailedAt DateTime  @default(now())
  // Set once this bucket has hit the lock threshold; cleared by a
  // successful login, an admin clear, or the start of a new window.
  lockUntil    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([scope, key])
  @@index([lastFailedAt])
}

model PatientProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  fullName    String
  dateOfBirth DateTime?
  // Nullable, no FK relation on purpose — the minor/dependent consent and
  // account-ownership model is an explicit open PRD question (§8.2.5), not
  // resolved here. Don't build on top of this field assuming it means
  // anything enforced yet.
  guardianUserId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  paymentIntents PaymentIntent[]
  referrals      Referral[]
}

model DoctorProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  fullName           String
  verificationStatus VerificationStatus @default(pending)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialties       DoctorSpecialty[]
  availabilitySlots AvailabilitySlot[]
  appointments      Appointment[]
  // Referral sides a doctor can sit on: `referringReferrals` are ones
  // they created; `targetedReferrals` are ones aimed at them (whether
  // they ultimately see the patient or not).
  referringReferrals Referral[]       @relation("ReferralReferringDoctor")
  targetedReferrals  Referral[]       @relation("ReferralTargetDoctor")

  @@index([verificationStatus])
}

model Specialty {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  doctors DoctorSpecialty[]
}

model DoctorSpecialty {
  id              String @id @default(uuid())
  doctorProfileId String
  specialtyId     String

  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  specialty     Specialty     @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@unique([doctorProfileId, specialtyId])
}

model FacilityProfile {
  id        String       @id @default(uuid())
  userId    String       @unique
  name      String
  type      FacilityType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  capabilities   FacilityCapability[]
  paymentIntents PaymentIntent[]
  walletLink     WalletLink?
}

model FacilityCapability {
  id                String         @id @default(uuid())
  facilityProfileId String
  capabilityType    CapabilityType
  // e.g. a lab test category, or a medication class — free text on purpose,
  // no controlled vocabulary decided yet (out of Phase 1 scope).
  detail String?

  facilityProfile FacilityProfile @relation(fields: [facilityProfileId], references: [id], onDelete: Cascade)

  @@unique([facilityProfileId, capabilityType, detail])
}

model AvailabilitySlot {
  id              String     @id @default(uuid())
  doctorProfileId String
  status          SlotStatus @default(open)
  startTime       DateTime
  endTime         DateTime
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  appointment   Appointment?

  // Prevents two slot ROWS for the same doctor/time range (duplicate
  // generation). This is NOT what prevents double-BOOKING of one slot by
  // two patients — that's the conditional `UPDATE ... WHERE status =
  // 'open'` in availability/services, inside a transaction. See
  // ARCHITECTURE.md §5.1 and the integration test in
  // backend/tests/integration/booking.test.ts.
  @@unique([doctorProfileId, startTime, endTime])
  @@index([doctorProfileId, status])
}

model Appointment {
  id                 String            @id @default(uuid())
  patientProfileId   String
  doctorProfileId    String
  // Nullable because a CANCELLED appointment releases its slot back to
  // `open` (referral cascade / patient cancel) — the appointment keeps its
  // history row but must stop holding the unique claim on the slot, or
  // re-booking the freed slot would violate the unique constraint.
  // The booking guarantee itself is unchanged: claimOpenSlot's
  // conditional UPDATE on SlotStatus is what prevents double-booking.
  availabilitySlotId String?           @unique
  status             AppointmentStatus @default(scheduled)
  origin             AppointmentOrigin @default(direct_booking)
  // Set when this appointment was produced by accepting a Referral (issue
  // #7). The cascade rules (#67 / PRD §8.2.3) react to status transitions
  // on exactly these appointments. NOT unique: one referral can produce
  // several appointments over its life (re-booking after a cancellation).
  // Referral.resultingAppointmentId is the unique "current" pointer.
  referralId         String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  patientProfile   PatientProfile   @relation(fields: [patientProfileId], references: [id])
  doctorProfile    DoctorProfile    @relation(fields: [doctorProfileId], references: [id])
  availabilitySlot AvailabilitySlot? @relation(fields: [availabilitySlotId], references: [id])
  referral         Referral?        @relation("ReferralOriginatedAppointments", fields: [referralId], references: [id])
  // Non-owning side of Referral.resultingAppointmentId (the FK lives on
  // Referral) — which referral currently points at this appointment as
  // the one it produced.
  referralResultOf Referral?        @relation("ReferralResultingAppointment")
  consultation     Consultation?

  // TODO Phase 2: intakeId (FK -> IntakeForm). PRD FR-5 requires intake
  // before confirmation, not enforced yet — booking works without it in
  // Phase 1 so the concurrency-safety work isn't blocked on IntakeForm
  // existing. Flagged, not silently dropped.
}

// =========================================================================
// Below this line: Phase 0 structural placeholders, not yet implemented.
// See ROADMAP.md for phase order.
// =========================================================================

model IntakeForm {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  // TODO: patientProfileId, symptoms (Json), freeTextNotes
}

// Phase 3 (issue #5 minimal + lineage for #65): a Consultation is the
// record of a doctor having seen the patient at a specific appointment.
// `appointmentId` is the lineage seam — Referral.parentReferralId is
// derived through it (consultation → appointment → referral), which is
// what loop detection walks. Full consultation-note workflow (append-only
// addenda, sign-off) stays issue #4/#64's scope.
model Consultation {
  id            String              @id @default(uuid())
  appointmentId String?             @unique
  outcome       ConsultationOutcome?
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  referrals   Referral[]
}

// Phase 3 (issues #5/#65/#66/#67/#68). Snapshot rule (FR-7/FR-8, hard
// rule 3): `snapshotNotes` is a copy taken at creation, never a live
// reference — reassign/cancel/cascade never touch it.
model Referral {
  id                String         @id @default(uuid())
  status            ReferralStatus @default(pending)
  patientProfileId  String
  // The consultation this referral grew out of. Required: every referral
  // is created from a consultation (PRD FR-7), which is also what gives
  // loop detection its lineage.
  sourceConsultationId String
  referringDoctorId String
  // v1 requires a concrete target doctor — the routing rule for "a
  // specialty, no specific doctor" is an unresolved design gap
  // (ARCHITECTURE.md §6.1.2, issue #6), not silently defaulted here.
  targetDoctorId    String
  // Optional denormalised label of the target specialty, used by the
  // loop guard and admin views. Not a substitute for issue #23's real
  // per-doctor specialty management.
  targetSpecialtyId String?
  snapshotNotes     String
  // Issue #65: the referral whose appointment produced the consultation
  // this referral came from — the chain loop detection walks (bounded).
  parentReferralId  String?
  // Issue #67 bookkeeping: how many times a referral-origin appointment
  // has no-showed, and the "the referring doctor must know" flag set
  // when repeated no-shows expire the referral. Both live on the
  // referral (not a Notification row) because Phase 6's dispatch layer
  // doesn't exist yet — the flag is the seam it will read.
  noShowCount                Int       @default(0)
  referringDoctorNotifiedAt  DateTime?
  // Issue #65: set (with a reason naming the matching hop) when the
  // target doctor/specialty was already in the ancestor chain — the
  // referral is still created (a human decides), but surfaces in the
  // admin queue.
  loopFlaggedAt    DateTime?
  loopFlagReason   String?
  // Issue #68: admin-initiated cancellation carries its reason; the
  // audit trail proper is the AuditEvent row written alongside.
  cancelledReason  String?
  // The appointment this referral currently produced (null while
  // pending/declined, or after a cancelled/no-showed appointment returns
  // it to pending). Kept pointing at the last no-show when expired —
  // that appointment is why it expired.
  resultingAppointmentId String? @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  sourceConsultation Consultation  @relation(fields: [sourceConsultationId], references: [id])
  patientProfile     PatientProfile @relation(fields: [patientProfileId], references: [id])
  referringDoctor    DoctorProfile  @relation("ReferralReferringDoctor", fields: [referringDoctorId], references: [id])
  targetDoctor       DoctorProfile  @relation("ReferralTargetDoctor", fields: [targetDoctorId], references: [id])
  parentReferral     Referral?      @relation("ReferralLineage", fields: [parentReferralId], references: [id])
  childReferrals     Referral[]     @relation("ReferralLineage")
  resultingAppointment Appointment? @relation("ReferralResultingAppointment", fields: [resultingAppointmentId], references: [id])
  // Every appointment this referral ever produced (including cancelled/
  // no-showed ones) — history survives the resultingAppointmentId link
  // being cleared when the referral returns to pending.
  appointments        Appointment[] @relation("ReferralOriginatedAppointments")
  auditEvents         AuditEvent[]

  @@index([patientProfileId])
  @@index([referringDoctorId])
  @@index([targetDoctorId])
  @@index([status])
  @@index([loopFlaggedAt])
}

// Issue #68: who did what to a referral, when, and why. Deliberately a
// separate append-only table rather than columns smeared onto Referral —
// an audit trail that overwrites itself isn't one. Generic enough to grow
// order/prescription actions later without a migration.
model AuditEvent {
  id         String   @id @default(uuid())
  actorUserId String
  actorRole  String // 'admin' | 'doctor' | 'patient' | 'system'
  action     String // e.g. 'referral.reassign', 'referral.cancel'
  referralId String?
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  referral Referral? @relation(fields: [referralId], references: [id])

  @@index([referralId])
  @@index([action])
  @@index([createdAt])
}

model Prescription {
  id                     String      @id @default(uuid())
  status                 OrderStatus @default(issued)
  createdAt              DateTime    @default(now())
  // TODO: consultationId, patientProfileId, prescribingDoctorId, supersedesPrescriptionId (nullable, self-relation)
}

model PrescriptionItem {
  id       String @id @default(uuid())
  drugName String
  dosage   String
  frequency String
  duration String
  // TODO: prescriptionId
}

model LabOrder {
  id        String      @id @default(uuid())
  testType  String
  urgency   Urgency     @default(routine)
  status    OrderStatus @default(issued)
  createdAt DateTime    @default(now())
  // TODO: consultationId, patientProfileId, orderingDoctorId, supersedesLabOrderId (nullable, self-relation)
}

model LabResult {
  id            String   @id @default(uuid())
  resultFileUrl String?
  summary       String?
  createdAt     DateTime @default(now())
  // TODO: labOrderId (unique), fulfillingFacilityId
}

model FulfillmentRecord {
  id        String            @id @default(uuid())
  orderType String // "prescription" | "lab_order" — see ARCHITECTURE.md §6.1.3 caveat on this polymorphic design
  orderId   String
  status    FulfillmentStatus @default(pending)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  // TODO: facilityId
  // NOTE: this polymorphic (orderType, orderId) pair is flagged in
  // ARCHITECTURE.md §6.1.3 as a design smell to revisit — may be split
  // into PrescriptionFulfillment / LabOrderFulfillment before implementation.
}

model Notification {
  id        String   @id @default(uuid())
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime @default(now())
  // TODO: userId
}

// --- Stellar payments (docforum-org split) -------------------------------
// These two models hold relational metadata ONLY — amounts, status, tx
// hashes, public keys. No clinical/PHI field ever belongs here. The actual
// escrow contract logic lives in the sibling docforum-escrow repo and is
// called via the @docforum/escrow-sdk package from
// backend/src/modules/payments/services — never modeled or reimplemented
// in this schema. See docs/adr/0002-stellar-escrow-for-fulfillment-payout.md
// and docs/adr/0004-custodial-payments-v1.md.
//
// Deliberately decoupled from Prescription/LabOrder/FulfillmentRecord
// below — those are still Phase 0 placeholders (Phase 4/5, not built).
// `orderType`/`orderId` stay opaque, unvalidated references rather than
// real foreign keys, so this phase is buildable independently rather than
// blocked behind two unbuilt phases. Revisit once Phase 4/5 are real —
// see ADR 0004's "Known gap."

enum PaymentIntentStatus {
  created
  escrowed
  released
  refunded
  failed
}

enum OrderTypeForPayment {
  prescription
  lab_order
}

model PaymentIntent {
  id         String              @id @default(uuid())
  orderType  OrderTypeForPayment
  // Opaque — Prescription/LabOrder don't exist as real records yet
  // (Phase 4). Not validated against anything until then.
  orderId    String
  status     PaymentIntentStatus @default(created)

  patientProfileId String
  patientProfile   PatientProfile @relation(fields: [patientProfileId], references: [id])
  facilityId       String
  facility         FacilityProfile @relation(fields: [facilityId], references: [id])

  // Raw stroops (native XLM's smallest unit) — matches
  // @docforum/escrow-sdk's `amount: bigint` exactly. v1 is native-XLM
  // only, no decimal/currency-conversion layer: an earlier scaffold draft
  // of this model used a Decimal amount + "USDC" currency default,
  // dropped here in favor of what's actually proven end-to-end on
  // testnet (see ADR 0004). Multi-asset support is a future addition,
  // not assumed by this field.
  amountStroops BigInt

  // Set once funded (create_escrow succeeds) — needed to later call
  // release/refund against the right on-chain escrow.
  escrowId          BigInt?
  stellarTxHash     String?
  // Which deployed contract this intent was funded against — this repo
  // has already had two testnet contract IDs (Phase E1 vs. E2), so this
  // isn't hypothetical.
  sorobanContractId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([facilityId])
  @@index([status])
}

model WalletLink {
  id         String          @id @default(uuid())
  // Scoped to the facility being paid, not the patient — v1 is a
  // custodial model (docforum-core funds escrows from its own platform
  // Stellar identity; patients never hold or sign with a wallet here).
  // See ADR 0004.
  facilityId String          @unique
  facility   FacilityProfile @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  stellarPublicKey String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
